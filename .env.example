# Copy to .env and fill in. Never commit .env.
#
# Which backend to use: "anthropic", "openai", or "mock".
#   mock     -> offline deterministic stub (no key, no network)
#   anthropic-> Anthropic SDK
#   openai   -> OpenAI SDK (also covers OpenAI-compatible endpoints, e.g. OpenRouter, via OPENAI_BASE_URL)
LLM_PROVIDER=mock

# Model identifier passed through to the provider.
#   anthropic example: claude-opus-4-8
#   openai example:    gpt-4o-mini
#   openrouter example: anthropic/claude-3.5-sonnet
LLM_MODEL=claude-opus-4-8

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- OpenAI / OpenAI-compatible ---
OPENAI_API_KEY=
# Optional. Set to point at an OpenAI-compatible endpoint.
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
